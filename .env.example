# Script Runner configuration.
# Copy this file to `.env` (which is gitignored) and edit it. After any change run
# `docker compose up -d`; a plain `docker compose restart` does not re-read this file.

# Login accounts: comma-separated user:password pairs. Everyone listed has full access.
# Entries are split on the first ":" so passwords may contain ":" but not ",".
# Single-quote the whole value if a password contains $, #, spaces or quotes, e.g.
#   SCRIPT_RUNNER_USERS='alice:p@ss w0rd,bob:other'
SCRIPT_RUNNER_USERS=admin:change-me

# Random string that signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left empty a random key is used and everyone is logged out on each restart.
# Changing it logs everyone out immediately.
SECRET_KEY=

# How long a login stays valid, in hours. Default 168 (one week).
SESSION_MAX_AGE_HOURS=168

# Set to true only when the UI is served over https. On plain http the browser
# refuses to store a Secure cookie and nobody would be able to stay logged in.
COOKIE_SECURE=false
